 set( LIBCHDR_LIB_DIR ${BINARY_DIR} ${BINARY_DIR}/deps/zstd-1.5.6/build/cmake/lib/ ${BINARY_DIR}/deps/lzma-24.05/ )
else()
set(LIBCHDR_LIBRARIES  
 ${BINARY_DIR}/${CMAKE_STATIC_LIBRARY_PREFIX}chdr-static${CMAKE_STATIC_LIBRARY_SUFFIX}
